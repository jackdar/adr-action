{
  "compilerOptions": {
    "target": "ES2024",
    "module": "preserve",
    "lib": ["ES2024", "ESNext"],
    "esModuleInterop": true,
    "strict": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules"]
}
